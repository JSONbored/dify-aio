# Copy to docker/middleware.env for the source-code development stack.
# From docker/, run: docker compose --env-file middleware.env -f docker-compose.middleware.yaml -p dify up -d
# ------------------------------
# Environment Variables for db Service
# ------------------------------
# Database Configuration
# Database type, supported values are `postgresql` and `mysql`
DB_TYPE=postgresql

DB_USERNAME=postgres

DEBUG=

# Allow Evaluation to select and score Knowledge Retrieval v2 workflow nodes.
# Keep disabled until the Knowledge Retrieval v2 node implementation is deployed.
# Prevent DeepEval from loading local dotenv files or exporting telemetry from API/worker processes.
DEEPEVAL_DISABLE_DOTENV=1

DEEPEVAL_TELEMETRY_OPT_OUT=1

DEFAULT_VECTORIZER_MODULE=

# CLOSED deployments only. CLOUD enables tenant scheduling and direct Billing plan lookup;
# ENTERPRISE keeps the existing unrestricted document dispatch. Set the same edition on the
# Dify API/publisher and every KnowledgeFS API/worker process (root docker/.env for Dify).
DEPLOYMENT_EDITION=ENTERPRISE

DEPLOY_ENV=

DEVICE_FLOW_APPROVE_RATE_LIMIT_PER_HOUR=

DIFY_AGENT_API_TOKEN=dify-agent-run-token-for-dev-only

# Collect API-issued application traces into the Dify inner API inbox.
DIFY_AGENT_APPLICATION_TRACING_ENABLED=

DIFY_AGENT_BINDING_FILE_DOWNLOAD_COMMAND_TIMEOUT_SECONDS=

# RuntimeLease active limit; its default matches the independently configurable Agent run deadline.
DIFY_AGENT_E2B_ACTIVE_TIMEOUT_SECONDS=

# Set DIFY_AGENT_LOCAL_SANDBOX_AUTH_TOKEN only in docker/.env; Compose supplies it to both services.
# E2B_API_KEY and E2B_API_TOKEN remain accepted as deployment-level fallbacks.
DIFY_AGENT_E2B_API_KEY=

DIFY_AGENT_E2B_PROJECT_ID=

DIFY_AGENT_E2B_SHELLCTL_PORT=

DIFY_AGENT_E2B_TEMPLATE=difys-default-team/dify-agent-local-sandbox

DIFY_AGENT_INNER_API_KEY=

# Leave empty to derive from PLUGIN_DIFY_INNER_API_URL and PLUGIN_DIFY_INNER_API_KEY in Docker Compose.
# DIFY_AGENT_INNER_API_KEY must match API/worker INNER_API_KEY_FOR_PLUGIN, not INNER_API_KEY.
# Set PLUGIN_DIFY_INNER_API_KEY in docker/.env; keep the key expression below unchanged for the bundled API.
DIFY_AGENT_INNER_API_URL=

# ------------------------------
# Environment Variables for local_sandbox Service (Dify Agent shell workspaces)
# ------------------------------
# Leave empty to disable shellctl auth (local development default).
DIFY_AGENT_LOCAL_SANDBOX_AUTH_TOKEN=

DIFY_AGENT_LOCAL_SANDBOX_ENDPOINT=

# Auth: an OIDC bearer token, or mTLS bundle paths mounted into agent_backend.
DIFY_AGENT_OPENSHELL_BEARER_TOKEN=

# Optional JSON driver_config as a driver-keyed envelope (e.g.
# {"docker":{"mounts":[...]}}) for driver-specific mounts/options; empty
# sends no driver config. Home Snapshots are unsupported on this backend —
# new Bindings are always materialized image-fresh.
DIFY_AGENT_OPENSHELL_DRIVER_CONFIG=

# Optional comma-separated host:port egress allowlist (no scheme or path).
# Empty sends no network policy (gateway/driver default egress); when set,
# sandbox egress is enforced to exactly these endpoints — include the Agent
# Stub and files endpoints, e.g. agent.example.com:443,dify.example.com:443.
DIFY_AGENT_OPENSHELL_EGRESS_ALLOW=

DIFY_AGENT_OPENSHELL_EXEC_TIMEOUT_SECONDS=

# OpenShell backend (DIFY_AGENT_RUNTIME_BACKEND=openshell): sandboxes run on a
# self-hosted NVIDIA OpenShell gateway. Setup and validation:
# dify-agent/docs/dify-agent/guide/openshell.md
# gRPC endpoint as host:port (no scheme), e.g. localhost:17670.
# Requires an OpenShell gateway >= 0.1.3; upgrade the gateway and the bundled
# openshell SDK together.
DIFY_AGENT_OPENSHELL_GATEWAY_ENDPOINT=

# Set true only for plaintext local-dev gateways.
DIFY_AGENT_OPENSHELL_INSECURE=

DIFY_AGENT_OPENSHELL_READY_TIMEOUT_SECONDS=

# Required: build the runtime image yourself from this checkout; do not rely on a published latest tag.
# From the repository root (the directory containing dify-agent-runtime/):
#   docker build -f dify-agent-runtime/docker/Dockerfile -t dify-agent-runtime:latest dify-agent-runtime
# The image must include shellctl and iproute2. This value must match the built image tag.
# Build into the gateway's Docker daemon, or push to a registry it can pull from and use that image reference.
DIFY_AGENT_OPENSHELL_SANDBOX_IMAGE=

# Required. shellctl path isolation stays off (sandbox Landlock is authoritative).
# Sent as the Authorization bearer through the gateway's bearer-passthrough
# service endpoint; the gateway credential stays on the gRPC control plane.
DIFY_AGENT_OPENSHELL_SHELLCTL_AUTH_TOKEN=

DIFY_AGENT_OPENSHELL_SHELLCTL_PORT=

DIFY_AGENT_OPENSHELL_TLS_CA_PATH=

DIFY_AGENT_OPENSHELL_TLS_CLIENT_CERT_PATH=

DIFY_AGENT_OPENSHELL_TLS_CLIENT_KEY_PATH=

DIFY_AGENT_OPENSHELL_WORKSPACE=

# Shared outbound HTTP client timeouts and connection limits.
DIFY_AGENT_OUTBOUND_HTTP_CONNECT_TIMEOUT=

DIFY_AGENT_OUTBOUND_HTTP_KEEPALIVE_EXPIRY=

DIFY_AGENT_OUTBOUND_HTTP_MAX_CONNECTIONS=

DIFY_AGENT_OUTBOUND_HTTP_MAX_KEEPALIVE_CONNECTIONS=

DIFY_AGENT_OUTBOUND_HTTP_POOL_TIMEOUT=

DIFY_AGENT_OUTBOUND_HTTP_READ_TIMEOUT=

DIFY_AGENT_OUTBOUND_HTTP_WRITE_TIMEOUT=

DIFY_AGENT_PLUGIN_DAEMON_API_KEY=

# Leave empty to derive from PLUGIN_DAEMON_URL and PLUGIN_DAEMON_KEY in Docker Compose.
# Set PLUGIN_DAEMON_KEY in docker/.env when using the bundled daemon; keep the key expression below unchanged.
DIFY_AGENT_PLUGIN_DAEMON_URL=

DIFY_AGENT_REDIS_PREFIX=

# Leave empty to derive from REDIS_PASSWORD in Docker Compose.
DIFY_AGENT_REDIS_URL=

# Select exactly one coherent Home Snapshot + Sandbox backend.
DIFY_AGENT_RUNTIME_BACKEND=local

DIFY_AGENT_RUN_EVENT_STREAM_MAX_LENGTH=

DIFY_AGENT_RUN_RETENTION_SECONDS=

# Internal deadline for the Agent Backend model/tool loop. The effective run
# limit is whichever expires first: this value or the relevant API/Workflow
# outer execution limit. To allow every path to run for one hour, also set
# APP_MAX_EXECUTION_TIME and WORKFLOW_MAX_EXECUTION_TIME to at least 3600.
DIFY_AGENT_RUN_TIMEOUT_SECONDS=

# Sandbox-reachable Dify API base for signed /files/* transfers.
DIFY_AGENT_SANDBOX_FILES_BASE_URL=http://api:5001

# Independent sandbox usage ledger. API owns fixed activation time T0; no backfill.
# Enable only with matching API metering project settings and events API access.
# Celery Beat in the API triggers a protected one-shot collection endpoint.
# No operation logging, Agent polling loop, or collector Redis leader.
# Collection requires the existing DIFY_AGENT_API_TOKEN to be configured.
DIFY_AGENT_SANDBOX_METERING_ENABLED=

DIFY_AGENT_SANDBOX_METERING_FULL_SCAN_INTERVAL_SECONDS=

DIFY_AGENT_SANDBOX_METERING_MAX_PAGES=

DIFY_AGENT_SANDBOX_METERING_OVERLAP_SECONDS=

# This is security-sensitive: it derives the JWE encryption key for Agent Stub bearer tokens.
# Replace this development default in production.
# Generate one with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
DIFY_AGENT_SERVER_SECRET_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY

# JSON array of regex patterns to redact from shell output shown to the agent.
# The JWE token value is always redacted regardless of this setting.
# Example: DIFY_AGENT_SHELL_REDACT_PATTERNS=["sk-[A-Za-z0-9]+","ghp_[A-Za-z0-9]{36}"]
DIFY_AGENT_SHELL_REDACT_PATTERNS=

DIFY_AGENT_SHUTDOWN_GRACE_SECONDS=

DIFY_AGENT_STREAM_TEXT_DELTA_COALESCING_ENABLED=

DIFY_AGENT_STREAM_TEXT_DELTA_FLUSH_INTERVAL_MS=

DIFY_AGENT_STREAM_TEXT_DELTA_MAX_CHARS=

DIFY_AGENT_STUB_API_BASE_URL=http://agent_backend:5050/agent-stub

# Maximum Agent Stub upload and plugin tool BLOB persistence size in MiB;
# forwarded to Dify API as a signed byte limit.
DIFY_AGENT_STUB_UPLOAD_FILE_SIZE_LIMIT=

DIFY_AGENT_TRAJECTORY_ENABLED=

DIFY_AGENT_TRAJECTORY_EXPORT_TIMEOUT_MS=

DIFY_AGENT_TRAJECTORY_INCLUDE_CONTENT=

DIFY_AGENT_TRAJECTORY_MAX_EXPORT_BATCH_SIZE=

