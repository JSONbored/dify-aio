# Use a strong key for your deployment, generated with `openssl rand -base64 42`.
# Set the same value for CODE_EXECUTION_API_KEY in the API/worker configuration.
SANDBOX_API_KEY=dify-sandbox

# Dify's code executor requests networking for Code, Template, Jinja2 prompts and the Code tool.
# Setting false rejects those requests on every architecture.
# Sandbox 0.2.15 only allows epoll_pwait with networking enabled on both ARM64 and AMD64;
# network-disabled Python requests can fail with "operation not permitted" (observed on ARM64).
SANDBOX_ENABLE_NETWORK=true

